#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

grep -Fx 'go 1.26.0' go.mod >/dev/null
grep -Fx 'toolchain go1.27.0' go.mod >/dev/null
grep -F 'github.com/containernetworking/cni v1.3.0' go.mod >/dev/null
grep -F 'github.com/vishvananda/netns v0.0.5' go.mod >/dev/null
grep -F 'golang.org/x/sys v0.47.0' go.mod >/dev/null

grep -F 'defaultMetadataHost    = "169.254.169.250"' internal/metadata/client.go >/dev/null
grep -F 'alternateMetadataHost  = "169.254.169.251"' internal/metadata/client.go >/dev/null
grep -F 'metadataCARootPath     = "/var/lib/pasturestack/etc/ssl/ca.crt"' internal/metadata/client.go >/dev/null
grep -F 'transport.Proxy = nil' internal/metadata/client.go >/dev/null
grep -F 'return http.ErrUseLastResponse' internal/metadata/client.go >/dev/null
grep -F 'Transport: &policyTransport{' internal/metadata/client.go >/dev/null
grep -F 'root, err := os.OpenRoot(rootPath)' main.go >/dev/null

if grep -n -E \
    'os\.ReadFile\((caRootPath|requestedPath)\)|os\.OpenFile\(config\.LogToFile|http://metadata/2016-07-29' \
    main.go internal/metadata/client.go README.md SECURITY.md COMPATIBILITY.md; then
    echo 'unsafe metadata or log destination returned to the current source tree' >&2
    exit 1
fi
